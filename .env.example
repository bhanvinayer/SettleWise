# Server-only credentials. Never prefix secrets with VITE_ because Vite exposes
# VITE_ variables in the browser bundle.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Used by the LangGraph LLM policy-review node and SettleWise Agent.

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional server-side graph metadata
LANGGRAPH_PROJECT=settlewise
LANGSMITH_TRACING=false

# Local/deployment metadata
APP_ENV=development
APP_URL=http://localhost:3000
