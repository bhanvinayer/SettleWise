# Server-only credentials. Never prefix secrets with VITE_ because Vite exposes
# VITE_ variables in the browser bundle.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional server-side graph metadata
LANGGRAPH_PROJECT=settlewise
LANGSMITH_TRACING=false

# Local/deployment metadata
APP_ENV=development
APP_URL=http://localhost:3000
