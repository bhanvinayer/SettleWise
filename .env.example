# Client-safe app configuration. Leave secrets blank for local demo mode.
# Vite exposes only variables prefixed with VITE_ to browser code.

VITE_AI_PROVIDER=openai
VITE_AI_API_KEY=
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=

# LangGraph / LangSmith observability configuration
VITE_LANGGRAPH_API_URL=
VITE_LANGGRAPH_API_KEY=
VITE_LANGSMITH_API_KEY=
VITE_LANGSMITH_PROJECT=settlewise
VITE_LANGSMITH_TRACING=false

# Optional deployment metadata
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:3000
